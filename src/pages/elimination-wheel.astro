---
import Layout from '@/layouts/Layout.astro';
import HeaderIsland from '@/components/HeaderIsland';
import GlobalFooterIsland from '@/components/GlobalFooterIsland';
import EliminationIsland from '@/components/EliminationIsland';
import SchemaFAQ from '@/components/SchemaFAQ.astro';
import SchemaBreadcrumb from '@/components/SchemaBreadcrumb.astro';

const title = "Elimination Wheel — Spin to Eliminate Until One Winner";
const description = "Spin the elimination wheel and knock out one name each round until a single last-one-standing winner remains. Free battle-royale picker, instant, no signup.";

const defaultParticipants = [
  { pseudo: "Alice", weight: 1 },
  { pseudo: "Bob", weight: 1 },
  { pseudo: "Charlie", weight: 1 },
  { pseudo: "Diana", weight: 1 },
  { pseudo: "Ethan", weight: 1 },
  { pseudo: "Fiona", weight: 1 },
  { pseudo: "George", weight: 1 },
  { pseudo: "Hannah", weight: 1 },
];

const faqItems = [
  {
    question: "How does the elimination wheel work?",
    answer: "Add your names, then spin. Each spin lands on one name and removes it from the wheel. You spin again with the remaining names, round after round, until only one is left — that last one standing is the winner.",
  },
  {
    question: "What's the difference from a no-repeat wheel?",
    answer: "A no-repeat wheel just avoids picking the same name twice. The elimination wheel is built around the drama of knocking names out one by one and crowning a final survivor, with a round-by-round recap of who was eliminated when.",
  },
  {
    question: "Can the drawn name be the winner instead of being eliminated?",
    answer: "Yes. Switch to 'Drawn wins & leaves' mode: each spin pulls a name out as a pick instead of an elimination, so you can build a full finishing order (1st picked, 2nd picked, and so on).",
  },
  {
    question: "Is the elimination truly random?",
    answer: "Yes. Real Wheel Picker uses crypto.getRandomValues() — cryptographic randomness sourced from your device's hardware entropy. Each round is independent, fair and not predictable.",
  },
  {
    question: "How many people can I add?",
    answer: "As many as you like. With a lot of names the early rounds fly by; the tension builds as the wheel empties and the final few names are left fighting for the crown.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://realwheelpicker.com/elimination-wheel#app",
  "name": "Elimination Wheel — Real Wheel Picker",
  "url": "https://realwheelpicker.com/elimination-wheel",
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "isAccessibleForFree": true,
  "publisher": { "@type": "Organization", "@id": "https://realwheelpicker.com/#organization", "name": "Real Wheel Picker", "url": "https://realwheelpicker.com" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<Layout title={title} description={description} canonical="/elimination-wheel" jsonLd={jsonLd}>
  <SchemaFAQ items={faqItems} />
  <SchemaBreadcrumb items={[
    { name: "Home", url: "https://realwheelpicker.com" },
    { name: "Elimination Wheel", url: "https://realwheelpicker.com/elimination-wheel" },
  ]} />

  <div style="background: var(--gradient-bg)">
    <HeaderIsland client:idle />

    <h1 class="sr-only">Elimination Wheel — Spin to Eliminate Until One Winner Remains</h1>

    <div class="relative z-10 max-w-4xl mx-auto px-4 pt-2 pb-10">
      <!-- THE WHEEL — front and center -->
      <EliminationIsland
        defaultParticipants={defaultParticipants}
        client:load
      />
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- CONTENT BELOW THE FOLD                                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div style="background: var(--gradient-bg)">
    <main id="main" class="max-w-5xl mx-auto px-4 py-10 space-y-12">

      <!-- How it works -->
      <section class="p-6 rounded-xl border bg-card border-border space-y-4">
        <h2 class="text-xl md:text-2xl font-bold text-foreground">How the elimination wheel works</h2>
        <div class="grid sm:grid-cols-4 gap-4 pt-2">
          {[
            { step: "1", title: "Add the names", desc: "Type everyone in the running — players, chores, contestants — one per line." },
            { step: "2", title: "Spin to knock out", desc: "Each spin lands on one name and removes it from the wheel." },
            { step: "3", title: "Keep spinning", desc: "Round after round, the wheel empties and the tension climbs." },
            { step: "4", title: "Crown the survivor", desc: "When one name is left, that's your last one standing — confetti included." },
          ].map(({ step, title, desc }) => (
            <div class="p-4 rounded-xl bg-secondary/40 border border-border text-center">
              <div class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold text-sm flex items-center justify-center mx-auto mb-2">{step}</div>
              <p class="font-semibold text-foreground text-sm">{title}</p>
              <p class="text-xs text-muted-foreground mt-1">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- When to use -->
      <section class="space-y-6">
        <h2 class="text-xl md:text-2xl font-bold text-foreground">When to use the elimination wheel</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {[
            { icon: "🧹", title: "Who does the chore?", desc: "Last one standing has to do the dishes (or take out the bins). Spin people OUT until one unlucky name is left holding the sponge." },
            { icon: "🎮", title: "Stream battle royale", desc: "Run a viewer or team elimination bracket live. Each spin drops a name, the chat watches the survivors shrink to a single champion." },
            { icon: "🏆", title: "Home tournaments", desc: "Decide draft order or seed a bracket by eliminating names one at a time — no spreadsheet, no arguments." },
            { icon: "🎯", title: "Pick the last one", desc: "Flip to 'drawn wins & leaves' to build a clean finishing order: first out, second out, all the way down." },
            { icon: "🎂", title: "Party games", desc: "Musical-chairs energy without the chairs — eliminate guests round by round until you have a winner to hand the prize." },
            { icon: "👥", title: "Team picks & cuts", desc: "Trim a long list to a shortlist by knocking out names until only the keepers remain." },
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-xl border bg-card border-border space-y-2 hover:border-primary/40 transition-colors">
              <h3 class="font-bold text-foreground flex items-center gap-2"><span class="text-xl">{icon}</span>{title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Two modes -->
      <section class="p-6 rounded-xl border bg-primary/5 border-primary/20 space-y-4">
        <h2 class="text-xl md:text-2xl font-bold text-foreground">Two ways to play</h2>
        <p class="text-muted-foreground leading-relaxed">
          By default the wheel runs in <strong>"drawn is eliminated"</strong> mode — the name it lands on is knocked out, and the very last name still on the wheel is your winner. Prefer the opposite? Switch to <strong>"drawn wins &amp; leaves"</strong> and each spin pulls a name out as a pick, letting you build a full ordered list from first to last. Either way you get a round-by-round recap so you can replay exactly how it went down.
        </p>
        <a href="/" class="inline-block mt-2 text-primary font-semibold hover:underline">Try the classic Spin the Wheel →</a>
      </section>

      <!-- FAQs -->
      <section class="space-y-4">
        <h2 class="text-xl md:text-2xl font-bold text-foreground">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqItems.map(({ question, answer }) => (
            <details class="bg-card border border-border rounded-xl p-5 group">
              <summary class="font-semibold text-foreground cursor-pointer list-none flex items-center justify-between gap-2">
                {question}
                <span class="text-muted-foreground shrink-0 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-muted-foreground text-sm leading-relaxed mt-3">{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Tools -->
      <section class="space-y-4">
        <h2 class="text-xl md:text-2xl font-bold text-foreground">Related Tools</h2>
        <ul class="space-y-3">
          {[
            { href: "/", label: "Spin the Wheel", desc: "The full featured random picker." },
            { href: "/decision-wheel", label: "Decision Wheel", desc: "Spin to choose between any list of options." },
            { href: "/yes-no-wheel", label: "Yes or No Wheel", desc: "A quick random yes or no decision." },
          ].map(({ href, label, desc }) => (
            <li>
              <a href={href} class="flex items-start gap-3 p-4 bg-card border border-border rounded-xl hover:border-primary/50 hover:shadow-md transition-all">
                <span class="text-primary font-bold text-sm mt-0.5">→</span>
                <span>
                  <span class="font-semibold text-foreground">{label}</span>
                  <span class="text-muted-foreground text-sm"> — {desc}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

    </main>
    <GlobalFooterIsland client:idle />
  </div>
</Layout>
