---
import '../index.css';
import '../styles/editorial.css';
import CookieConsentBanner from '@/components/CookieConsentBanner';
// PWA: pwaInfo exposes the generated <link rel="manifest"> tag, pwaAssetsHead
// is unused here. Available because @vite-pwa/astro is registered in
// astro.config.mjs. Falls back to undefined when the integration is absent.
import { pwaInfo } from 'virtual:pwa-info';

interface HreflangLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
  locale?: string;
  hreflangLinks?: HreflangLink[];
  robots?: string;
}

const {
  title,
  description,
  canonical = '/',
  ogImage = 'https://realwheelpicker.com/og-default.png',
  ogImageAlt,
  ogType = 'website',
  jsonLd,
  locale = 'en_US',
  hreflangLinks,
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
} = Astro.props;

const BASE_URL = 'https://realwheelpicker.com';
const canonicalUrl = `${BASE_URL}${canonical}`;
const langCode = locale.split('_')[0];

// AdSense and Google Fonts are heavyweight and only useful in production.
// Loading them in dev mode triples page weight and can hang the browser
// when localhost can't reach the AdSense network reliably.
const isProd = import.meta.env.PROD;

const resolvedHreflang: HreflangLink[] = hreflangLinks ?? [
  { hreflang: langCode, href: canonicalUrl },
  { hreflang: 'x-default', href: langCode === 'en' ? canonicalUrl : `${BASE_URL}/` },
];
---

<!doctype html>
<html lang={langCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- EMBED MODE (?embed=1) — handled CLIENT-SIDE because this site is built
         with output:'static', so Astro.url.searchParams is not available per
         request at build time. This inline script runs in <head> BEFORE the
         first paint: if the URL carries embed=1 it tags <html> with the
         `rwp-embed` class (so the CSS below hides chrome with no flash) and
         flips the page to noindex so embedded copies don't get indexed. -->
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(window.location.search);
          if (p.get('embed') === '1') {
            document.documentElement.classList.add('rwp-embed');
            // The <meta name="robots"> tag is declared later in <head>, so it
            // does not exist yet when this script runs — create it if missing.
            var m = document.querySelector('meta[name="robots"]');
            if (!m) {
              m = document.createElement('meta');
              m.setAttribute('name', 'robots');
              document.head.appendChild(m);
            }
            m.setAttribute('content', 'noindex, nofollow');
          }
        } catch (e) { /* no-op */ }
      })();
    </script>
    <style is:inline>
      /* In embed mode, hide all site chrome: header, footer, ads, cookie
         banner. Selectors:
           - header / footer  → the sticky <header> (HeaderIsland) and the
             <footer> (GlobalFooterIsland) site furniture.
           - ins.adsbygoogle / [data-ad-client]  → live AdSense units (AdUnit).
           - [data-rwp-cookie]  → the cookie consent card AND its collapsed chip.
         The attribution bar (.rwp-embed-attribution) is shown only here. */
      .rwp-embed header,
      .rwp-embed footer,
      .rwp-embed ins.adsbygoogle,
      .rwp-embed [data-ad-client],
      .rwp-embed [data-rwp-cookie] {
        display: none !important;
      }
      /* Theme tokens are raw HSL components (e.g. "45 93% 47%"), so they must be
         wrapped in hsl(...). Hex fallbacks cover the case where vars are absent. */
      .rwp-embed-attribution { display: none; }
      .rwp-embed .rwp-embed-attribution {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        font-size: 0.7rem;
        line-height: 1;
        color: hsl(var(--muted-foreground, 222 18% 38%));
        background: hsl(var(--card, 38 30% 99%));
        border-top: 1px solid hsl(var(--border, 38 18% 78%));
      }
      .rwp-embed-attribution a {
        color: hsl(var(--primary, 45 93% 47%));
        font-weight: 600;
        text-decoration: none;
      }
      .rwp-embed-attribution a:hover { text-decoration: underline; }
    </style>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {isProd && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" /></noscript>
        <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
      </>
    )}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta property="og:site_name" content="Real Wheel Picker" />
    <meta property="og:locale" content={locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@realwheelpicker" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

    <!-- Hreflang -->
    {resolvedHreflang.map(({ hreflang, href }) => (
      <link
        rel="alternate"
        hreflang={hreflang}
        href={href.startsWith('http') ? href : `${BASE_URL}${href}`}
      />
    ))}

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <meta name="theme-color" content="#0a0f1a" />
    <meta name="indexnow-key" content="a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5" />

    <!-- PWA manifest — link tag generated by @vite-pwa/astro (virtual:pwa-info).
         set:html injects the <link rel="manifest" ...> as-is. -->
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <a
      href="#main"
      class="absolute left-2 top-2 -translate-y-20 focus:translate-y-0 z-[2000] rounded-md bg-foreground px-4 py-2 text-sm font-medium text-background shadow-lg transition-transform"
    >
      Skip to main content
    </a>
    <slot />

    <!-- Embed attribution bar — hidden by default, revealed by the CSS above
         only when <html> has the `rwp-embed` class. Keeps a backlink when the
         tool is embedded in an iframe. -->
    <div class="rwp-embed-attribution">
      <span aria-hidden="true">🎡</span>
      <span>Powered by <a href="https://realwheelpicker.com" target="_blank" rel="noopener">Real Wheel Picker</a></span>
    </div>

    <CookieConsentBanner client:idle />

    <!-- PWA service worker registration. virtual:pwa-register is resolved by
         @vite-pwa/astro at build time; registerType:'autoUpdate' means the SW
         self-updates on the next navigation. immediate:true registers right
         away so offline support is primed on first visit. -->
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>

    {isProd && (
      <!-- AdSense — deferred until after first paint to protect LCP / INP. Production only. -->
      <script is:inline>
        (function () {
          var ADSENSE_SRC = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8978154316839498';
          function loadAdsense() {
            // Use a custom attribute (data-rwp-adsense) — `data-adsense` is
            // intercepted by the Google AdSense script itself and triggers a
            // "AdSense head tag doesn't support data-adsense attribute" warning
            // x3 in the console. Using our own namespaced attribute is silent.
            if (document.querySelector('script[data-rwp-adsense]')) return;
            var s = document.createElement('script');
            s.src = ADSENSE_SRC;
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.setAttribute('data-rwp-adsense', '1');
            document.head.appendChild(s);
          }
          function schedule() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadAdsense, { timeout: 4000 });
            } else {
              setTimeout(loadAdsense, 2500);
            }
          }
          if (document.readyState === 'complete') {
            schedule();
          } else {
            window.addEventListener('load', schedule, { once: true });
          }
        })();
      </script>
    )}
  </body>
</html>
