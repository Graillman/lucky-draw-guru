# Cloudflare Pages redirects. Destinations are canonical: absolute path,
# NO trailing slash (matches astro trailingSlash:'never' + build.format:'file').
#
# ORDER MATTERS: Cloudflare evaluates top-to-bottom, first match wins.
# Specific slug remaps must come BEFORE the generic trailing-slash splat,
# otherwise "/team-generator/" would hit the splat (-> /team-generator) before
# the slug remap (-> /classroom-picker) and create a 301 -> 301 chain.

# --- Removed/renamed tools: 301 to the closest functional equivalent so
#     existing internal links and external backlinks keep their value.
#     Both slashed and unslashed variants point STRAIGHT at the final target
#     to avoid any 301 -> 301 hop. ---
/random-wheel              /wheel-of-names     301
/random-wheel/             /wheel-of-names     301
/random-name-picker        /wheel-of-names     301
/random-name-picker/       /wheel-of-names     301
/team-generator            /classroom-picker   301
/team-generator/           /classroom-picker   301
/random-team-selector      /classroom-picker   301
/random-team-selector/     /classroom-picker   301
/secret-santa-picker       /giveaway-picker    301
/secret-santa-picker/      /giveaway-picker    301
/raffle-picker             /giveaway-picker    301
/raffle-picker/            /giveaway-picker    301
/yes-or-no-wheel           /yes-no-wheel       301
/yes-or-no-wheel/          /yes-no-wheel       301
/random-number-generator   /random-number-picker  301
/random-number-generator/  /random-number-picker  301
/random-decision-maker     /decision-wheel     301
/random-decision-maker/    /decision-wheel     301
/random-winner-picker      /giveaway-picker    301
/random-winner-picker/     /giveaway-picker    301

# --- Pages that previously did a client-side meta-refresh (Astro.redirect in
#     a static build emits <meta http-equiv="refresh">, which Google treats as
#     a soft/JS redirect). Replace with real edge 301s to their true targets. ---
/social-giveaway           /giveaway-picker      301
/social-giveaway/          /giveaway-picker      301
/teacher-picker            /classroom-picker     301
/teacher-picker/           /classroom-picker     301
/probability-picker        /weighted-random-picker  301
/probability-picker/       /weighted-random-picker  301

# --- Generic trailing-slash normalization. Any path that ends in "/" (and is
#     not the root) 301s to the same path without the slash. Cloudflare's
#     :splat captures everything the leading "*" matched (the path minus its
#     trailing slash). Keep this LAST so the specific rules above win first. ---
/*/   /:splat   301
